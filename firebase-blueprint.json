{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User accounts, roles, and profiles for students and instructors",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "instructor", "admin"] },
        "password": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "sessions": {
      "title": "Counseling Practice Sessions",
      "description": "Simulated counseling session transcripts, deterministic stats, and supervisor scorecard evaluations",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "vignetteId": { "type": "string" },
        "vignetteTitle": { "type": "string" },
        "modality": { "type": "string" },
        "difficulty": { "type": "string" },
        "mode": { "type": "string" },
        "turnsCount": { "type": "number" },
        "totalDurationSeconds": { "type": "number" },
        "rubricScore": { "type": "object" },
        "transcript": { "type": "array" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "vignetteId", "transcript", "timestamp"]
    },
    "cases": {
      "title": "Case Studies & Clinical Personas",
      "description": "Clinical vignettes, patient personas, psychological backgrounds, and planted cues",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "modality": { "type": "string" },
        "difficulty": { "type": "string" },
        "clientName": { "type": "string" },
        "clientAge": { "type": "number" },
        "clientRole": { "type": "string" },
        "presentingProblem": { "type": "string" },
        "positiveTriggers": { "type": "array" },
        "negativeTriggers": { "type": "array" },
        "counselorIntakeGoal": { "type": "string" },
        "nonVerbalCues": { "type": "array" },
        "isCustom": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "authorEmail": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "clientName", "presentingProblem", "counselorIntakeGoal"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
